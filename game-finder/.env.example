# 游戏导购助手微服务（按名查价 / 读本站榜单 / 搜口碑）配置模板
#
# 用法：把本文件复制为同目录下的 .env，填入自己的值。.env 已被 .gitignore 排除。

# 任意兼容 OpenAI 接口的服务都可以，这里以 DeepSeek 官方地址为例
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Java 应用地址（纯地址、无密钥），要带 context path。
# browse_deals 工具靠它读取本应用数据库里的折扣 / 热销 / 喜加一——与商城里看到的是同一份数据。
# 用 Tomcat 的默认配置跑就是下面这个；改了端口或 WAR 名时同步改这里。
# 填错的表现：助手问「有什么好价」时会如实说「连不上应用」，而不是给出一堆没根据的推荐。
STREAM_BASE_URL=http://localhost:8080/ex_final_stream

# 服务监听端口。
# 键名与 Java 侧 app.properties 的 game-finder.port / 环境变量 GAME_FINDER_PORT 相同，
# 两边必须填一致，否则 Java 会调到一个没人监听的端口，页面上表现为「微服务未启动」。
GAME_FINDER_PORT=8090

# 调用网络搜索（duckduckgo，用于查游戏口碑）时走的代理，留空表示直连。
# 国内网络通常需要挂一个本地代理，例如 Clash 默认的 http://127.0.0.1:7890
PROXY=